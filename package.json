{
  "name": "vrcinema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted live HLS channel for VRChat video players: queue YouTube, pixeldrain, CDA links and local files",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wordoftiger-ux/VRCinema.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
