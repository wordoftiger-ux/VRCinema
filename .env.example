# Skopiuj ten plik jako .env i uzupełnij.

# Hasło do panelu /admin (wymagane)
ADMIN_PASSWORD=zmien-mnie

# Sekret do podpisywania sesji. Ustaw długi losowy ciąg, żeby sesje przetrwały restart.
SESSION_SECRET=

# Port serwera
PORT=8080

# Język komunikatów serwera, panelu i dziennika (tylko serwer Rust `vrcinema`):
# en (domyślny), pl, es, de, fr, ja. Język plansz ustawia się w panelu (Ustawienia → Kanał).
# LANGUAGE=en

# Publiczny adres (np. z Cloudflare Tunnel), pokazywany na stronach. Puste = adres z przeglądarki.
PUBLIC_URL=

# Enkoder wideo przy konwersji: libx264 (procesor), h264_nvenc (NVIDIA), h264_qsv (Intel), h264_amf (AMD)
# albo auto (tylko serwer Rust `vrcinema`: test karty graficznej przy starcie, inaczej libx264)
VIDEO_ENCODER=libx264

# true, gdy serwer stoi za Cloudflare Tunnel (prawdziwy IP widza z CF-Connecting-IP)
TRUST_CLOUDFLARE=false
# true, gdy serwer stoi za innym reverse proxy (X-Forwarded-For), np. Caddy na VPS
TRUST_PROXY=false

# Opcjonalnie: plik cookies.txt dla yt-dlp (np. gdy YouTube wymaga zalogowania)
YTDLP_COOKIES=

# Opcjonalnie: foldery z filmami na dysku, które możesz puszczać z panelu (rozdziel średnikiem)
# Przykład: MEDIA_DIRS=D:\Filmy;E:\Seriale   (Linux: MEDIA_DIRS=/srv/filmy;/mnt/dysk/seriale)
MEDIA_DIRS=

# Opcjonalnie: klucz API pixeldrain (z ustawień konta), gdy pliki trafiają na limit pobierania
PIXELDRAIN_API_KEY=

# Opcjonalnie: własne ścieżki narzędzi i czcionki do plansz
# (Linux: domyślnie pierwsza znaleziona DejaVu Sans, np. z pakietu fonts-dejavu-core)
# FFMPEG_PATH=
# FFPROBE_PATH=
# YTDLP_PATH=
# FONT_FILE=

# Opcjonalnie: wejście OBS (RTMP, port osobny od strony, nigdy przez tunel); klucz min. 16 znaków
# OBS_STREAM_KEY=
# OBS_PORT=1935
# OBS_LAN=0
# OBS_PRIORITY=1
